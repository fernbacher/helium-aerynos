#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

CHROME_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
DEST="$HOME/.local/share/helium-widevine"
HELIUM_WIDEVINE="$HOME/.config/net.imput.helium/WidevineCdm"
HINT_FILE="$HELIUM_WIDEVINE/latest-component-updated-widevine-cdm"
TMP=""

cleanup() {
    if [[ -n "${TMP}" && -d "${TMP}" ]]; then
        rm -rf -- "${TMP}"
    fi
}
trap cleanup EXIT

for cmd in ar bsdtar curl grep sed; do
    command -v "$cmd" >/dev/null 2>&1 || {
        printf 'Missing required command: %s\n' "$cmd" >&2
        exit 1
    }
done

TMP="$(mktemp -d)"
printf 'Downloading current Google Widevine CDM...\n'

curl --fail --location --silent --show-error \
    --output "$TMP/chrome.deb" "$CHROME_URL"

cd "$TMP"
ar x chrome.deb

data_archive=""
for archive in data.tar.*; do
    [[ -f "$archive" ]] || continue
    data_archive="$archive"
    break
done

[[ -n "$data_archive" ]] || {
    printf 'Could not find data.tar.* inside Chrome package.\n' >&2
    exit 1
}

bsdtar -xf "$data_archive" ./opt/google/chrome/WidevineCdm/
SRC="$TMP/opt/google/chrome/WidevineCdm"

[[ -f "$SRC/manifest.json" ]] || {
    printf 'Widevine manifest.json not found.\n' >&2
    exit 1
}
[[ -f "$SRC/_platform_specific/linux_x64/libwidevinecdm.so" ]] || {
    printf 'Widevine library not found.\n' >&2
    exit 1
}

VERSION="$(
    grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$SRC/manifest.json" |
    sed 's/.*"\([^"]*\)"$/\1/'
)"
[[ -n "$VERSION" ]] || {
    printf 'Could not determine Widevine version.\n' >&2
    exit 1
}

CURRENT_VERSION=""
if [[ -f "$DEST/manifest.json" ]]; then
    CURRENT_VERSION="$(
        grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$DEST/manifest.json" 2>/dev/null |
        sed 's/.*"\([^"]*\)"$/\1/' || true
    )"
fi

if [[ "$CURRENT_VERSION" == "$VERSION" ]] && \
   [[ -f "$DEST/_platform_specific/linux_x64/libwidevinecdm.so" ]]; then
    printf 'Widevine is already current: %s\n' "$VERSION"
    mkdir -p "$HELIUM_WIDEVINE"
    printf '{"Path":"%s"}\n' "$DEST" > "$HINT_FILE"
    exit 0
fi

printf 'Installing Widevine %s' "$VERSION"
[[ -z "$CURRENT_VERSION" ]] || printf ' over %s' "$CURRENT_VERSION"
printf '...\n'

NEW="${DEST}.new"
rm -rf -- "$NEW"
mkdir -p -- "$NEW"
cp -a "$SRC/." "$NEW/"
chmod 755 "$NEW/_platform_specific/linux_x64/libwidevinecdm.so"
rm -rf -- "$DEST"
mv -- "$NEW" "$DEST"
mkdir -p -- "$HELIUM_WIDEVINE"
printf '{"Path":"%s"}\n' "$DEST" > "$HINT_FILE"
printf 'Widevine installed successfully: %s\n' "$VERSION"
printf 'Path: %s\n' "$DEST"
